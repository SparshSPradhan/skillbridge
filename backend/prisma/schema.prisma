generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TRAINER
  INSTITUTION
  PROGRAMME_MANAGER
  MONITORING_OFFICER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique @map("clerk_user_id")
  name          String
  email         String   @unique
  role          Role
  institutionId String?  @map("institution_id")
  createdAt     DateTime @default(now()) @map("created_at")

  institution   User?    @relation("InstitutionUsers", fields: [institutionId], references: [id])
  managedUsers  User[]   @relation("InstitutionUsers")

  trainerBatches  BatchTrainer[]
  studentBatches  BatchStudent[]
  createdBatches  Batch[]        @relation("BatchCreator")
  trainedSessions Session[]
  attendance      Attendance[]
  inviteLinks     InviteLink[]

  @@map("users")
}

model Batch {
  id            String   @id @default(cuid())
  name          String
  institutionId String   @map("institution_id")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  institution User           @relation("BatchCreator", fields: [createdById], references: [id])
  trainers    BatchTrainer[]
  students    BatchStudent[]
  sessions    Session[]
  inviteLinks InviteLink[]

  @@map("batches")
}

model BatchTrainer {
  batchId   String @map("batch_id")
  trainerId String @map("trainer_id")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer User  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([batchId, trainerId])
  @@map("batch_trainers")
}

model BatchStudent {
  batchId   String   @map("batch_id")
  studentId String   @map("student_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([batchId, studentId])
  @@map("batch_students")
}

model Session {
  id        String   @id @default(cuid())
  batchId   String   @map("batch_id")
  trainerId String   @map("trainer_id")
  title     String
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer    User         @relation(fields: [trainerId], references: [id])
  attendance Attendance[]

  @@map("sessions")
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  status    AttendanceStatus
  markedAt  DateTime         @default(now()) @map("marked_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("attendance")
}

model InviteLink {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  batchId    String    @map("batch_id")
  createdBy  String    @map("created_by")
  expiresAt  DateTime? @map("expires_at")
  usageCount Int       @default(0) @map("usage_count")
  maxUsage   Int?      @map("max_usage")
  createdAt  DateTime  @default(now()) @map("created_at")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@map("invite_links")
}